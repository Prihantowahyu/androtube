<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Player Frame -->
    <FrameLayout
        android:id="@+id/playerContainer"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@color/black">

        <!-- Media3 PlayerView -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:show_buffering="always"
            app:use_controller="true" />

        <!-- Web Fallback Player (Garansi 100% video berputar tanpa blokir bot) -->
        <WebView
            android:id="@+id/playerWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Audio-Only RAM Saver Overlay -->
        <LinearLayout
            android:id="@+id/layoutAudioOnly"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#151A22"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_headphones" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Mode Audio Saja Aktif"
                android:textColor="@color/secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Decoding video dinonaktifkan • Hemat RAM &amp; Baterai"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Loading spinner -->
        <ProgressBar
            android:id="@+id/playerLoading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary"
            android:visibility="gone" />

        <!-- Swipe Gesture Overlay Indicator (Brightness / Volume) -->
        <TextView
            android:id="@+id/tvGestureFeedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_badge_ram"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollDetails"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title -->
            <TextView
                android:id="@+id/tvPlayerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Judul Video YouTube Terbaru Super Ringan" />

            <!-- Stats -->
            <TextView
                android:id="@+id/tvPlayerStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="1.234.567 x ditonton • 3 hari lalu" />

            <!-- Action Buttons Scroll Strip -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Mode Audio Toggle Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleAudioMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mode Audio"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        app:icon="@drawable/ic_headphones"
                        app:iconTint="@color/secondary"
                        app:backgroundTint="@color/surface_variant"
                        app:cornerRadius="20dp" />

                    <!-- Quality Picker Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="360p"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        app:backgroundTint="@color/surface_variant"
                        app:cornerRadius="20dp" />

                    <!-- Playback Speed Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="1.0x"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        app:backgroundTint="@color/surface_variant"
                        app:cornerRadius="20dp" />

                    <!-- Download Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDownload"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Unduh"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        app:icon="@drawable/ic_download"
                        app:iconTint="@color/text_primary"
                        app:backgroundTint="@color/surface_variant"
                        app:cornerRadius="20dp" />

                    <!-- Sleep Timer Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Timer"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        app:icon="@drawable/ic_timer"
                        app:iconTint="@color/text_primary"
                        app:backgroundTint="@color/surface_variant"
                        app:cornerRadius="20dp" />

                    <!-- Bookmark Button -->
                    <ImageView
                        android:id="@+id/btnPlayerBookmark"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:padding="8dp"
                        android:background="@drawable/bg_circle_button"
                        android:src="@drawable/ic_bookmark_border"
                        android:contentDescription="Simpan" />

                    <!-- PiP (Picture in Picture / Floating Window) Button -->
                    <ImageView
                        android:id="@+id/btnPiP"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:padding="8dp"
                        android:background="@drawable/bg_circle_button"
                        android:src="@drawable/ic_pip"
                        android:contentDescription="Layar Mengambang (PiP)" />
                </LinearLayout>
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/divider" />

            <!-- Channel Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivPlayerChannelAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_whytube_logo"
                    android:contentDescription="Channel" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPlayerChannelName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Nama Channel" />

                    <TextView
                        android:id="@+id/tvPlayerSubscribers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        tools:text="500 rb subscriber" />
                </LinearLayout>
            </LinearLayout>

            <!-- Video Description (Collapsible / Lite) -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/surface"
                android:padding="12dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="Deskripsi video lengkap akan muncul di sini. Klik untuk melihat selengkapnya..." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Video Terkait"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Related Videos RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRelatedVideos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_video" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
